{
  "name": "meterflow",
  "version": "1.0.0",
  "description": "High-Precision Usage Metering & Billing Engine with idempotent metering, quota enforcement, exact token pricing, and Stripe test-mode integration.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/scripts/seed.js",
    "test": "node --test --test-concurrency=1 src/tests/*.test.js",
    "worker": "node src/scripts/runWorker.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkashKodihithlu/MeterFlow.git"
  },
  "keywords": [
    "metering",
    "billing",
    "stripe",
    "idempotency",
    "quotas",
    "tokens",
    "pricing"
  ],
  "author": "Akash Kodihithlu",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "stripe": "^23.0.0"
  }
}
