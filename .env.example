# MeterFlow Environment Configuration Example
# Copy this file to .env and configure your environment variables

PORT=3000
NODE_ENV=development
DATABASE_PATH=./data/meterflow.db

# Stripe Configuration (Test Mode Only)
# Get your test keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_placeholder_key_not_real
STRIPE_WEBHOOK_SECRET=whsec_placeholder_test_secret

# Background Worker Interval (in milliseconds, default: 60000ms = 1 min)
WORKER_INTERVAL_MS=60000

# Base URL for callbacks / checkout redirects
APP_BASE_URL=http://localhost:3000
